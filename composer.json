{
    "name": "decodelabs/monarch",
    "description": "A single shared source of truth for your PHP apps",
    "type": "library",
    "keywords": [ ],
    "license": "MIT",
    "authors": [ {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        } ],
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0.2",

        "decodelabs/enumerable": "^0.2.8",
        "decodelabs/exceptional": "^0.6.3",
        "decodelabs/kingdom": "^0.1.0"

    },
    "require-dev": {
        "decodelabs/phpstan-decodelabs": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Monarch\\": "src/Monarch/"
        },
        "files": [
            "src/Monarch.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
